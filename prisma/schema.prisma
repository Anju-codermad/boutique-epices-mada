generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) — modèles requis par l'adapter Prisma
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  addresses Address[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum CertificationType {
  BIO
  EQUITABLE
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String
  certifications CertificationType[]
  isNew          Boolean             @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants Variant[]
  images   ProductImage[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// Prix et stock exprimés en centimes/unités entières pour éviter les erreurs
// d'arrondi flottant. priceTtcCents est le prix TTC (obligation légale UE).
model Variant {
  id            String @id @default(cuid())
  sku           String @unique
  weightGrams   Int
  priceTtcCents Int
  stock         Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductImage {
  id       String @id @default(cuid())
  url      String
  alt      String
  position Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum ReviewStatus {
  PENDING
  APPROVED
}

model Review {
  id      String       @id @default(cuid())
  rating  Int
  comment String
  status  ReviewStatus @default(PENDING)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Commandes
// ---------------------------------------------------------------------------

model Address {
  id         String  @id @default(cuid())
  fullName   String
  line1      String
  line2      String?
  postalCode String
  city       String
  country    String  @default("FR")
  phone      String?

  // Optionnel : une adresse peut être créée pour une commande "guest checkout"
  // sans compte utilisateur associé.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

// value : pourcentage (0-100) si type = PERCENTAGE, centimes si type = FIXED_AMOUNT
model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique
  type       CouponType
  value      Int
  validFrom  DateTime   @default(now())
  validUntil DateTime?
  maxUses    Int?
  usedCount  Int        @default(0)

  orders Order[]

  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  status     OrderStatus @default(PENDING)
  guestEmail String?

  totalTtcCents Int
  shippingCents Int @default(0)
  discountCents Int @default(0)

  trackingNumber String?
  carrier        String?

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  // Renseignée quand l'admin passe la commande à DELIVERED ; sert de point de départ
  // au délai légal de rétractation de 14 jours (vente à distance UE).
  deliveredAt DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// Prix figé au moment de l'achat (indépendant d'une évolution ultérieure du
// prix de la variante).
model OrderItem {
  id                String @id @default(cuid())
  quantity          Int
  unitPriceTtcCents Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Newsletter
// ---------------------------------------------------------------------------

enum NewsletterStatus {
  PENDING
  CONFIRMED
}

model NewsletterSubscriber {
  id                String           @id @default(cuid())
  email             String           @unique
  status            NewsletterStatus @default(PENDING)
  confirmationToken String?          @unique

  subscribedAt DateTime @default(now())
}
