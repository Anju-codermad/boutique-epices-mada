# Supabase Postgres — connexion poolée (pgBouncer) utilisée par l'application
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Supabase Postgres — connexion directe, utilisée uniquement par les migrations Prisma
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Auth.js — secret de signature des sessions (générer avec `npx auth secret`)
AUTH_SECRET=""

# Resend — envoi des liens de connexion (magic link) et des emails transactionnels
RESEND_API_KEY=""
EMAIL_FROM="Boutique d'épices de Madagascar <no-reply@example.com>"

# URL publique du site, utilisée pour générer les liens dans les emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Adresse recevant les messages du formulaire de contact
CONTACT_EMAIL="contact@example.com"

# Stripe — paiement (mode test avant mise en production)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry — monitoring d'erreurs (facultatif : sans DSN, le SDK ne fait rien)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Requis uniquement pour l'upload des source maps au build (facultatif)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
