# Variables d'environnement de PRODUCTION — à configurer dans Vercel (Project Settings →
# Environment Variables), jamais commitées avec de vraies valeurs. Voir aussi le tableau
# récapitulatif dans README.md ("Déploiement (Vercel + Supabase)").
#
# Différences avec .env.example (développement local) :
#  - les clés Stripe doivent être les clés LIVE (pas les clés test)
#  - NEXT_PUBLIC_APP_URL doit être le domaine réel de production
#  - le domaine d'envoi Resend doit être vérifié (SPF/DKIM) avant mise en ligne, sinon les
#    emails transactionnels partent en spam

# Supabase Postgres — connexion poolée (pgBouncer), utilisée par l'application en production
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Supabase Postgres — connexion directe, utilisée uniquement par les migrations Prisma
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Auth.js — secret de signature des sessions (générer avec `npx auth secret`, différent de
# celui utilisé en local/preview)
AUTH_SECRET=""

# Resend — domaine d'envoi vérifié (SPF/DKIM) obligatoire en production
RESEND_API_KEY=""
EMAIL_FROM="Boutique d'épices de Madagascar <no-reply@votre-domaine.fr>"

# Domaine réel de production (jamais localhost ni une URL de preview Vercel)
NEXT_PUBLIC_APP_URL="https://votre-domaine.fr"

# Adresse recevant les messages du formulaire de contact
CONTACT_EMAIL="contact@votre-domaine.fr"

# Stripe — clés LIVE (mode production, pas les clés test "sk_test_...")
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Supabase Storage — upload des images produits (bucket public "product-images")
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
# Clé "service role" (Project Settings → API) : accès complet au bucket, jamais exposée au
# client, utilisée uniquement dans les Server Actions admin.
SUPABASE_SERVICE_ROLE_KEY=""

# Sentry — monitoring d'erreurs (recommandé en production ; sans DSN, le SDK ne fait rien)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Requis uniquement pour l'upload des source maps au build (facultatif)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Upstash Redis — limitation de débit sur /api/checkout et /api/contact (recommandé en
# production ; sans ces identifiants, la limitation est désactivée plutôt que de bloquer
# tout le monde)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
